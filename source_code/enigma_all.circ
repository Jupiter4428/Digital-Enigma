<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="4.0.4" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6">
    <tool name="Text Tool">
      <a name="text" val=""/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="center"/>
      <a name="valign" val="base"/>
    </tool>
  </lib>
  <main name="enigma_top"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar>
    <tool lib="6" name="Poke Tool"/>
    <tool lib="6" name="Edit Tool"/>
    <tool lib="0" name="Pin"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="NOT Gate"/>
  </toolbar>

  <!-- ══════════════════════════════════════════════════════════
       CIRCUIT 1 : mod26_add
       S = (A + B) mod 26
       ────────────────────────────────────────────────────────
       Components:
         2× Bit Extender (5→6)
         1× Adder 6-bit            [sum = A+B, max=50]
         1× Constant 0x1A=26 6-bit
         1× Comparator 6-bit       [sum >= 26 ?]
         1× Adder 6-bit            [sum - 26]
         1× Constant 0x1A=26 6-bit (for subtraction: use negation)
         1× MUX 2:1 6-bit          [sel=cmp: 0=sum, 1=sum-26]
         1× Bit Selector (bits 4:0)
       ══════════════════════════════════════════════════════════ -->
  <circuit name="mod26_add">
    <a name="circuit" val="mod26_add"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <!-- Inputs -->
    <comp lib="0" loc="(30,100)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="A"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(30,160)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="B"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- Bit Extenders 5→6 -->
    <comp lib="0" loc="(110,100)" name="Bit Extender">
      <a name="in_width" val="5"/>
      <a name="out_width" val="6"/>
      <a name="type" val="zero"/>
    </comp>
    <comp lib="0" loc="(110,160)" name="Bit Extender">
      <a name="in_width" val="5"/>
      <a name="out_width" val="6"/>
      <a name="type" val="zero"/>
    </comp>

    <!-- Adder 6-bit  (sum = A_ext + B_ext) -->
    <comp lib="3" loc="(220,130)" name="Adder">
      <a name="width" val="6"/>
    </comp>

    <!-- Constant 26 = 0x1A  (for subtraction: sum - 26 = sum + (-26 twos comp) = sum + 0x26) -->
    <!-- We use a second Adder as subtractor: sum + (64-26) with carry = sum - 26 mod 64 -->
    <!-- Simpler: use Subtractor component -->
    <comp lib="3" loc="(350,130)" name="Subtractor">
      <a name="width" val="6"/>
    </comp>
    <comp lib="0" loc="(290,150)" name="Constant">
      <a name="width" val="6"/>
      <a name="value" val="0x1a"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- Comparator 6-bit: A >= B  (sum >= 26) -->
    <comp lib="3" loc="(350,220)" name="Comparator">
      <a name="width" val="6"/>
      <a name="mode" val="unsigned"/>
    </comp>
    <comp lib="0" loc="(290,240)" name="Constant">
      <a name="width" val="6"/>
      <a name="value" val="0x1a"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- MUX 2:1 6-bit  sel=0→sum (A<26), sel=1→sum-26 (A>=26) -->
    <comp lib="2" loc="(460,150)" name="Multiplexer">
      <a name="width" val="6"/>
      <a name="select" val="1"/>
    </comp>

    <!-- Bit Selector: take bits 4:0 from 6-bit result -->
    <comp lib="0" loc="(560,150)" name="Bit Selector">
      <a name="in_width" val="6"/>
      <a name="out_width" val="5"/>
      <a name="low_bit" val="0"/>
    </comp>

    <!-- Output -->
    <comp lib="0" loc="(640,150)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="S"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- Wires -->
    <wire from="(30,100)" to="(80,100)"/>
    <wire from="(80,100)" to="(80,100)"/>
    <wire from="(30,160)" to="(80,160)"/>

    <!-- Extender outputs → Adder inputs -->
    <wire from="(140,100)" to="(190,100)"/>
    <wire from="(190,100)" to="(190,120)"/>
    <wire from="(190,120)" to="(200,120)"/>
    <wire from="(140,160)" to="(190,160)"/>
    <wire from="(190,160)" to="(190,140)"/>
    <wire from="(190,140)" to="(200,140)"/>

    <!-- Adder sum output → Subtractor input A + Comparator input A + MUX input 0 -->
    <wire from="(250,130)" to="(270,130)"/>
    <wire from="(270,130)" to="(270,210)"/>
    <!-- sum → Subtractor A -->
    <wire from="(270,130)" to="(320,130)"/>
    <!-- sum → Comparator A -->
    <wire from="(270,210)" to="(320,210)"/>
    <!-- sum → MUX input 0 (sel=0) -->
    <wire from="(270,130)" to="(270,170)"/>
    <wire from="(270,170)" to="(440,170)"/>
    <wire from="(440,170)" to="(440,160)"/>

    <!-- Constant 26 → Subtractor B (sum - 26) -->
    <wire from="(290,150)" to="(320,150)"/>

    <!-- Subtractor output (sum-26) → MUX input 1 (sel=1) -->
    <wire from="(380,130)" to="(420,130)"/>
    <wire from="(420,130)" to="(420,140)"/>
    <wire from="(420,140)" to="(440,140)"/>

    <!-- Constant 26 → Comparator B -->
    <wire from="(290,240)" to="(320,240)"/>

    <!-- Comparator A>=B output → MUX sel -->
    <wire from="(350,220)" to="(400,220)"/>
    <wire from="(400,220)" to="(400,155)"/>
    <wire from="(400,155)" to="(440,155)"/>

    <!-- MUX output → Bit Selector -->
    <wire from="(480,150)" to="(540,150)"/>

    <!-- Bit Selector output → Pin S -->
    <wire from="(580,150)" to="(640,150)"/>
  </circuit>

  <!-- ══════════════════════════════════════════════════════════
       CIRCUIT 2 : mod26_sub
       D = (A - B + 26) mod 26
       ────────────────────────────────────────────────────────
       Key insight: mod26_sub(A,B) = mod26_add(A, 26-B)
       So: compute C = (26-B), then call mod26_add(A,C)
       ── In one circuit: ──
         Constant 26 (5-bit) - B = C  (always 1..26)
         Then A + C mod 26  (same structure as mod26_add)
       ══════════════════════════════════════════════════════════ -->
  <circuit name="mod26_sub">
    <a name="circuit" val="mod26_sub"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <!-- Inputs -->
    <comp lib="0" loc="(30,100)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="A"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(30,180)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="B"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- Step 1: C = 26 - B -->
    <comp lib="3" loc="(160,180)" name="Subtractor">
      <a name="width" val="5"/>
    </comp>
    <comp lib="0" loc="(100,160)" name="Constant">
      <a name="width" val="5"/>
      <a name="value" val="0x1a"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- Step 2: Bit Extenders (A→6bit, C→6bit) -->
    <comp lib="0" loc="(240,100)" name="Bit Extender">
      <a name="in_width" val="5"/>
      <a name="out_width" val="6"/>
      <a name="type" val="zero"/>
    </comp>
    <comp lib="0" loc="(240,180)" name="Bit Extender">
      <a name="in_width" val="5"/>
      <a name="out_width" val="6"/>
      <a name="type" val="zero"/>
    </comp>

    <!-- Adder: sum = A_ext + C_ext -->
    <comp lib="3" loc="(350,140)" name="Adder">
      <a name="width" val="6"/>
    </comp>

    <!-- Subtractor: sum - 26 -->
    <comp lib="3" loc="(470,140)" name="Subtractor">
      <a name="width" val="6"/>
    </comp>
    <comp lib="0" loc="(410,160)" name="Constant">
      <a name="width" val="6"/>
      <a name="value" val="0x1a"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- Comparator: sum >= 26 -->
    <comp lib="3" loc="(470,230)" name="Comparator">
      <a name="width" val="6"/>
      <a name="mode" val="unsigned"/>
    </comp>
    <comp lib="0" loc="(410,250)" name="Constant">
      <a name="width" val="6"/>
      <a name="value" val="0x1a"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- MUX -->
    <comp lib="2" loc="(580,160)" name="Multiplexer">
      <a name="width" val="6"/>
      <a name="select" val="1"/>
    </comp>

    <!-- Bit Selector -->
    <comp lib="0" loc="(670,160)" name="Bit Selector">
      <a name="in_width" val="6"/>
      <a name="out_width" val="5"/>
      <a name="low_bit" val="0"/>
    </comp>

    <!-- Output -->
    <comp lib="0" loc="(750,160)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="D"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- Wires -->
    <wire from="(100,160)" to="(120,160)"/>
    <wire from="(30,180)" to="(120,180)"/>
    <wire from="(120,160)" to="(120,170)"/>
    <wire from="(120,170)" to="(130,170)"/>
    <wire from="(190,180)" to="(200,180)"/>
    <wire from="(30,100)" to="(200,100)"/>
    <wire from="(200,100)" to="(210,100)"/>
    <wire from="(200,180)" to="(210,180)"/>
    <wire from="(270,100)" to="(310,100)"/>
    <wire from="(310,100)" to="(310,130)"/>
    <wire from="(310,130)" to="(320,130)"/>
    <wire from="(270,180)" to="(310,180)"/>
    <wire from="(310,180)" to="(310,150)"/>
    <wire from="(310,150)" to="(320,150)"/>
    <wire from="(380,140)" to="(400,140)"/>
    <wire from="(400,140)" to="(400,220)"/>
    <wire from="(400,140)" to="(440,140)"/>
    <wire from="(400,220)" to="(440,220)"/>
    <wire from="(410,160)" to="(440,160)"/>
    <wire from="(410,250)" to="(440,250)"/>
    <wire from="(500,140)" to="(550,140)"/>
    <wire from="(550,140)" to="(550,150)"/>
    <wire from="(550,150)" to="(560,150)"/>
    <wire from="(400,140)" to="(550,170)"/>
    <wire from="(550,170)" to="(560,170)"/>
    <wire from="(500,230)" to="(560,230)"/>
    <wire from="(560,230)" to="(560,165)"/>
    <wire from="(560,165)" to="(560,155)"/>
    <wire from="(600,160)" to="(650,160)"/>
    <wire from="(690,160)" to="(750,160)"/>
  </circuit>

  <!-- ══════════════════════════════════════════════════════════
       CIRCUIT 3 : plugboard
       ROM-based: plugboard_map[char_in] → char_out
       ────────────────────────────────────────────────────────
       Wiring: A↔F B↔R C↔X D↔W E↔K  (same as enigma.v)
       ROM[26] =
         00: 05  (A→F)
         01: 11  (B→R)
         02: 17  (C→X)
         03: 16  (D→W)
         04: 0a  (E→K)
         05: 00  (F→A)
         06: 06  (G)
         07: 07  (H)
         08: 08  (I)
         09: 09  (J)
         0a: 04  (K→E)
         0b: 0b  (L)
         0c: 0c  (M)
         0d: 0d  (N)
         0e: 0e  (O)
         0f: 0f  (P)
         10: 10  (Q)
         11: 01  (R→B)
         12: 12  (S)
         13: 13  (T)
         14: 14  (U)
         15: 15  (V)
         16: 03  (W→D)
         17: 02  (X→C)
         18: 18  (Y)
         19: 19  (Z)
       ══════════════════════════════════════════════════════════ -->
  <circuit name="plugboard">
    <a name="circuit" val="plugboard"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <comp lib="0" loc="(40,130)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="char_in"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="4" loc="(200,130)" name="ROM">
      <a name="addrWidth" val="5"/>
      <a name="dataWidth" val="5"/>
      <a name="contents">addr/data
0 05 11 17 16 0a 00 06 07 08 09 04 0b 0c 0d 0e 0f
10 10 01 12 13 14 15 03 02 18 19
</a>
    </comp>

    <comp lib="0" loc="(360,130)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="char_out"/>
      <a name="facing" val="east"/>
    </comp>

    <wire from="(40,130)" to="(160,130)"/>
    <wire from="(240,130)" to="(360,130)"/>
  </circuit>

  <!-- ══════════════════════════════════════════════════════════
       CIRCUIT 4 : reflector
       ROM-based: UKW-B  YRUHQSLDPXNGOKMIEBFZCWVJAT
       ────────────────────────────────────────────────────────
       ROM[26]:
         00:18  01:11  02:14  03:07  04:10  05:12  06:0b  07:03
         08:0f  09:17  0a:0d  0b:06  0c:0e  0d:0a  0e:0c  0f:08
         10:04  11:01  12:05  13:19  14:02  15:16  16:15  17:09
         18:00  19:13
       ══════════════════════════════════════════════════════════ -->
  <circuit name="reflector">
    <a name="circuit" val="reflector"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <comp lib="0" loc="(40,130)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="char_in"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="4" loc="(200,130)" name="ROM">
      <a name="addrWidth" val="5"/>
      <a name="dataWidth" val="5"/>
      <a name="contents">addr/data
0 18 11 14 07 10 12 0b 03 0f 17 0d 06 0e 0a 0c 08
10 04 01 05 19 02 16 15 09 00 13
</a>
    </comp>

    <comp lib="0" loc="(360,130)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="char_out"/>
      <a name="facing" val="east"/>
    </comp>

    <wire from="(40,130)" to="(160,130)"/>
    <wire from="(240,130)" to="(360,130)"/>
  </circuit>

  <!-- ══════════════════════════════════════════════════════════
       CIRCUIT 5 : rotor_fw
       Forward pass through one rotor
       ────────────────────────────────────────────────────────
       Logic (from enigma.v):
         idx      = mod26_add(char_in, pos)
         sub      = ROM_fw[idx]           ← lookup
         char_out = mod26_sub(sub, pos)
       ────────────────────────────────────────────────────────
       Inputs:  char_in[4:0], pos[4:0], sel[1:0]
                sel: 01=RotorI  10=RotorII  11=RotorIII
       Output:  char_out[4:0]
       ────────────────────────────────────────────────────────
       ROMs (32×5):
       Rotor I fw  : 04 0a 0c 05 0b 06 03 10 15 19 0d 13 0e 16 18 07 17 14 12 0f 00 08 01 11 02 09
       Rotor II fw : 00 09 03 0a 12 08 11 14 17 01 0b 07 16 13 0c 02 10 06 19 0d 0f 18 05 15 0e 04
       Rotor III fw: 01 03 05 07 09 0b 02 0f 11 13 17 15 19 0d 18 04 08 16 06 00 0a 0c 14 12 10 0e
       ── MUX selects which ROM output to use ──
       ══════════════════════════════════════════════════════════ -->
  <circuit name="rotor_fw">
    <a name="circuit" val="rotor_fw"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <!-- Inputs -->
    <comp lib="0" loc="(30,80)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="char_in"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(30,160)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="pos"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(30,230)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="2"/>
      <a name="label" val="sel"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- mod26_add subcircuit: idx = (char_in + pos) mod 26 -->
    <comp lib="6" loc="(180,120)" name="rotor_fw">
    </comp>

    <!-- ROM Rotor I forward -->
    <comp lib="4" loc="(330,80)" name="ROM">
      <a name="addrWidth" val="5"/>
      <a name="dataWidth" val="5"/>
      <a name="label" val="ROM_I_fw"/>
      <a name="contents">addr/data
0 04 0a 0c 05 0b 06 03 10 15 19 0d 13 0e 16 18 07
10 17 14 12 0f 00 08 01 11 02 09
</a>
    </comp>

    <!-- ROM Rotor II forward -->
    <comp lib="4" loc="(330,180)" name="ROM">
      <a name="addrWidth" val="5"/>
      <a name="dataWidth" val="5"/>
      <a name="label" val="ROM_II_fw"/>
      <a name="contents">addr/data
0 00 09 03 0a 12 08 11 14 17 01 0b 07 16 13 0c 02
10 10 06 19 0d 0f 18 05 15 0e 04
</a>
    </comp>

    <!-- ROM Rotor III forward -->
    <comp lib="4" loc="(330,280)" name="ROM">
      <a name="addrWidth" val="5"/>
      <a name="dataWidth" val="5"/>
      <a name="label" val="ROM_III_fw"/>
      <a name="contents">addr/data
0 01 03 05 07 09 0b 02 0f 11 13 17 15 19 0d 18 04
10 08 16 06 00 0a 0c 14 12 10 0e
</a>
    </comp>

    <!-- MUX 4:1 (5-bit) select ROM output by sel -->
    <comp lib="2" loc="(470,180)" name="Multiplexer">
      <a name="width" val="5"/>
      <a name="select" val="2"/>
    </comp>

    <!-- mod26_sub subcircuit: char_out = (sub - pos) mod 26 -->

    <!-- Output -->
    <comp lib="0" loc="(640,180)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="char_out"/>
      <a name="facing" val="east"/>
    </comp>
  </circuit>

  <!-- ══════════════════════════════════════════════════════════
       CIRCUIT 6 : rotor_bw
       Backward pass (same structure, different ROMs)
       ────────────────────────────────────────────────────────
       ROMs (32×5):
       Rotor I bw  : 14 16 18 06 00 03 05 0f 15 19 01 04 02 0a 0c 13 07 17 12 0b 11 08 0d 10 0e 09
       Rotor II bw : 00 09 0f 02 19 16 11 0b 05 01 03 0a 0e 13 18 14 10 06 04 0d 07 17 0c 08 15 12
       Rotor III bw: 13 00 06 01 0f 02 12 03 10 04 14 05 15 0d 19 07 18 08 17 09 16 0b 11 0a 0e 0c
       ══════════════════════════════════════════════════════════ -->
  <circuit name="rotor_bw">
    <a name="circuit" val="rotor_bw"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <!-- Inputs -->
    <comp lib="0" loc="(30,80)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="char_in"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(30,160)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="pos"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(30,230)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="2"/>
      <a name="label" val="sel"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- ROM Rotor I backward -->
    <comp lib="4" loc="(330,80)" name="ROM">
      <a name="addrWidth" val="5"/>
      <a name="dataWidth" val="5"/>
      <a name="label" val="ROM_I_bw"/>
      <a name="contents">addr/data
0 14 16 18 06 00 03 05 0f 15 19 01 04 02 0a 0c 13
10 07 17 12 0b 11 08 0d 10 0e 09
</a>
    </comp>

    <!-- ROM Rotor II backward -->
    <comp lib="4" loc="(330,180)" name="ROM">
      <a name="addrWidth" val="5"/>
      <a name="dataWidth" val="5"/>
      <a name="label" val="ROM_II_bw"/>
      <a name="contents">addr/data
0 00 09 0f 02 19 16 11 0b 05 01 03 0a 0e 13 18 14
10 10 06 04 0d 07 17 0c 08 15 12
</a>
    </comp>

    <!-- ROM Rotor III backward -->
    <comp lib="4" loc="(330,280)" name="ROM">
      <a name="addrWidth" val="5"/>
      <a name="dataWidth" val="5"/>
      <a name="label" val="ROM_III_bw"/>
      <a name="contents">addr/data
0 13 00 06 01 0f 02 12 03 10 04 14 05 15 0d 19 07
10 18 08 17 09 16 0b 11 0a 0e 0c
</a>
    </comp>

    <!-- MUX 4:1 -->
    <comp lib="2" loc="(470,180)" name="Multiplexer">
      <a name="width" val="5"/>
      <a name="select" val="2"/>
    </comp>

    <!-- Output -->
    <comp lib="0" loc="(640,180)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="char_out"/>
      <a name="facing" val="east"/>
    </comp>
  </circuit>

  <!-- ══════════════════════════════════════════════════════════
       CIRCUIT 7 : stepping
       Double-stepping rotor position control
       (see stepping_new.circ for full wired version)
       ── Logic ──
         CLR = NOT(RST)
         Rotor_III EN = KEYPRESS
         Rotor_II  EN = (pos1==21 OR pos2==12) AND KEYPRESS
         Rotor_I   EN = (pos2==12) AND KEYPRESS
         Counter max=25, 5-bit
       ══════════════════════════════════════════════════════════ -->
  <circuit name="stepping">
    <a name="circuit" val="stepping"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <comp lib="0" loc="(50,80)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="CLK"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(50,190)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="RST"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(50,310)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="KEYPRESS"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="1" loc="(150,190)" name="NOT Gate">
      <a name="facing" val="east"/>
      <a name="size" val="30"/>
    </comp>

    <comp lib="4" loc="(310,100)" name="Counter">
      <a name="width" val="5"/>
      <a name="max" val="25"/>
      <a name="label" val="Rotor_III"/>
    </comp>
    <comp lib="4" loc="(310,260)" name="Counter">
      <a name="width" val="5"/>
      <a name="max" val="25"/>
      <a name="label" val="Rotor_II"/>
    </comp>
    <comp lib="4" loc="(310,420)" name="Counter">
      <a name="width" val="5"/>
      <a name="max" val="25"/>
      <a name="label" val="Rotor_I"/>
    </comp>

    <comp lib="3" loc="(530,140)" name="Comparator">
      <a name="width" val="5"/>
      <a name="mode" val="unsigned"/>
    </comp>
    <comp lib="0" loc="(470,160)" name="Constant">
      <a name="width" val="5"/>
      <a name="value" val="0x15"/>
    </comp>

    <comp lib="3" loc="(530,300)" name="Comparator">
      <a name="width" val="5"/>
      <a name="mode" val="unsigned"/>
    </comp>
    <comp lib="0" loc="(470,320)" name="Constant">
      <a name="width" val="5"/>
      <a name="value" val="0x0c"/>
    </comp>

    <comp lib="1" loc="(630,220)" name="OR Gate">
      <a name="facing" val="east"/>
      <a name="inputs" val="2"/>
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(720,220)" name="AND Gate">
      <a name="facing" val="east"/>
      <a name="inputs" val="2"/>
      <a name="size" val="30"/>
    </comp>
    <comp lib="1" loc="(720,370)" name="AND Gate">
      <a name="facing" val="east"/>
      <a name="inputs" val="2"/>
      <a name="size" val="30"/>
    </comp>

    <comp lib="0" loc="(440,100)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="POS1"/>
    </comp>
    <comp lib="0" loc="(440,260)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="POS2"/>
    </comp>
    <comp lib="0" loc="(440,420)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="POS3"/>
    </comp>

    <wire from="(50,190)" to="(120,190)"/>
    <wire from="(180,190)" to="(200,190)"/>
    <wire from="(200,110)" to="(200,430)"/>
    <wire from="(200,110)" to="(310,110)"/>
    <wire from="(200,270)" to="(310,270)"/>
    <wire from="(200,430)" to="(310,430)"/>
    <wire from="(200,190)" to="(200,110)"/>
    <wire from="(50,80)" to="(220,80)"/>
    <wire from="(220,80)" to="(220,410)"/>
    <wire from="(220,80)" to="(310,80)"/>
    <wire from="(220,240)" to="(310,240)"/>
    <wire from="(220,400)" to="(310,400)"/>
    <wire from="(220,80)" to="(220,240)"/>
    <wire from="(220,240)" to="(220,400)"/>
    <wire from="(50,310)" to="(240,310)"/>
    <wire from="(240,310)" to="(240,90)"/>
    <wire from="(240,90)" to="(310,90)"/>
    <wire from="(240,310)" to="(690,310)"/>
    <wire from="(690,310)" to="(690,210)"/>
    <wire from="(690,210)" to="(700,210)"/>
    <wire from="(690,310)" to="(700,370)"/>
    <wire from="(360,100)" to="(440,100)"/>
    <wire from="(360,100)" to="(400,100)"/>
    <wire from="(400,100)" to="(400,130)"/>
    <wire from="(400,130)" to="(490,130)"/>
    <wire from="(470,160)" to="(490,160)"/>
    <wire from="(360,260)" to="(440,260)"/>
    <wire from="(360,260)" to="(410,260)"/>
    <wire from="(410,260)" to="(410,290)"/>
    <wire from="(410,290)" to="(490,290)"/>
    <wire from="(470,320)" to="(490,320)"/>
    <wire from="(360,420)" to="(440,420)"/>
    <wire from="(530,140)" to="(560,140)"/>
    <wire from="(560,140)" to="(560,210)"/>
    <wire from="(560,210)" to="(600,210)"/>
    <wire from="(530,300)" to="(570,300)"/>
    <wire from="(570,300)" to="(570,230)"/>
    <wire from="(570,230)" to="(600,230)"/>
    <wire from="(570,300)" to="(580,300)"/>
    <wire from="(580,300)" to="(580,360)"/>
    <wire from="(580,360)" to="(700,360)"/>
    <wire from="(630,220)" to="(660,220)"/>
    <wire from="(660,220)" to="(660,200)"/>
    <wire from="(660,200)" to="(700,200)"/>
    <wire from="(720,220)" to="(750,220)"/>
    <wire from="(750,220)" to="(750,250)"/>
    <wire from="(750,250)" to="(310,250)"/>
    <wire from="(720,370)" to="(760,370)"/>
    <wire from="(760,370)" to="(760,410)"/>
    <wire from="(760,410)" to="(310,410)"/>
  </circuit>

  <!-- ══════════════════════════════════════════════════════════
       CIRCUIT 8 : cipher_path
       Full 9-stage cipher datapath (combinational)
       ────────────────────────────────────────────────────────
       Inputs:  char_in[4:0], pos1[4:0], pos2[4:0], pos3[4:0]
       Output:  char_out[4:0]
       ────────────────────────────────────────────────────────
       Stage 1 : plugboard(char_in)           → pb_out
       Stage 2 : rotor_fw(pb_out,  pos1, 3)   → r3f  [sel=11 = RotorIII]
       Stage 3 : rotor_fw(r3f,     pos2, 2)   → r2f  [sel=10 = RotorII ]
       Stage 4 : rotor_fw(r2f,     pos3, 1)   → r1f  [sel=01 = RotorI  ]
       Stage 5 : reflector(r1f)               → ref
       Stage 6 : rotor_bw(ref,     pos3, 1)   → r1b  [sel=01 = RotorI  ]
       Stage 7 : rotor_bw(r1b,     pos2, 2)   → r2b  [sel=10 = RotorII ]
       Stage 8 : rotor_bw(r2b,     pos1, 3)   → r3b  [sel=11 = RotorIII]
       Stage 9 : plugboard(r3b)               → char_out
       ══════════════════════════════════════════════════════════ -->
  <circuit name="cipher_path">
    <a name="circuit" val="cipher_path"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <!-- Inputs -->
    <comp lib="0" loc="(30,100)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="char_in"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(30,200)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="pos1"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(30,280)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="pos2"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(30,360)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="pos3"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- Stage 1: plugboard -->
    <comp lib="6" loc="(180,100)" name="plugboard"/>

    <!-- Stage 2: Rotor III forward (sel=3) -->
    <comp lib="6" loc="(310,100)" name="rotor_fw"/>
    <comp lib="0" loc="(270,120)" name="Constant">
      <a name="width" val="2"/>
      <a name="value" val="0x3"/>
    </comp>

    <!-- Stage 3: Rotor II forward (sel=2) -->
    <comp lib="6" loc="(440,100)" name="rotor_fw"/>
    <comp lib="0" loc="(400,120)" name="Constant">
      <a name="width" val="2"/>
      <a name="value" val="0x2"/>
    </comp>

    <!-- Stage 4: Rotor I forward (sel=1) -->
    <comp lib="6" loc="(570,100)" name="rotor_fw"/>
    <comp lib="0" loc="(530,120)" name="Constant">
      <a name="width" val="2"/>
      <a name="value" val="0x1"/>
    </comp>

    <!-- Stage 5: reflector -->
    <comp lib="6" loc="(700,100)" name="reflector"/>

    <!-- Stage 6: Rotor I backward (sel=1) -->
    <comp lib="6" loc="(830,100)" name="rotor_bw"/>
    <comp lib="0" loc="(790,120)" name="Constant">
      <a name="width" val="2"/>
      <a name="value" val="0x1"/>
    </comp>

    <!-- Stage 7: Rotor II backward (sel=2) -->
    <comp lib="6" loc="(960,100)" name="rotor_bw"/>
    <comp lib="0" loc="(920,120)" name="Constant">
      <a name="width" val="2"/>
      <a name="value" val="0x2"/>
    </comp>

    <!-- Stage 8: Rotor III backward (sel=3) -->
    <comp lib="6" loc="(1090,100)" name="rotor_bw"/>
    <comp lib="0" loc="(1050,120)" name="Constant">
      <a name="width" val="2"/>
      <a name="value" val="0x3"/>
    </comp>

    <!-- Stage 9: plugboard -->
    <comp lib="6" loc="(1220,100)" name="plugboard"/>

    <!-- Output -->
    <comp lib="0" loc="(1320,100)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="char_out"/>
      <a name="facing" val="east"/>
    </comp>
  </circuit>

  <!-- ══════════════════════════════════════════════════════════
       CIRCUIT 9 : enigma_top
       Top-level: stepping + cipher_path + I/O
       ────────────────────────────────────────────────────────
       Inputs:  CLK, RST, KEYPRESS, char_in[4:0]
       Outputs: char_out[4:0], valid_out
       ── Flow ──
         1. stepping: CLK,RST,KEYPRESS → POS1,POS2,POS3
         2. cipher_path: char_in,POS1,POS2,POS3 → raw_out
         3. D Flip-Flop / Register: latch raw_out on KEYPRESS
         4. valid_out: register KEYPRESS, high 1 cycle
       ══════════════════════════════════════════════════════════ -->
  <circuit name="enigma_top">
    <a name="circuit" val="enigma_top"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <!-- Inputs -->
    <comp lib="0" loc="(40,80)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="CLK"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(40,160)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="RST"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(40,240)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="KEYPRESS"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(40,320)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="char_in"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- Stepping subcircuit -->
    <comp lib="6" loc="(250,180)" name="stepping"/>

    <!-- Cipher path subcircuit -->
    <comp lib="6" loc="(500,300)" name="cipher_path"/>

    <!-- Output register (latch char_out when KEYPRESS=1) -->
    <comp lib="4" loc="(700,300)" name="Register">
      <a name="width" val="5"/>
      <a name="label" val="out_reg"/>
    </comp>

    <!-- valid_out D flip-flop (register KEYPRESS) -->
    <comp lib="4" loc="(700,400)" name="Register">
      <a name="width" val="1"/>
      <a name="label" val="valid_reg"/>
    </comp>

    <!-- Outputs -->
    <comp lib="0" loc="(830,300)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="5"/>
      <a name="label" val="char_out"/>
      <a name="facing" val="east"/>
    </comp>
    <comp lib="0" loc="(830,400)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="valid_out"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- ── Display section ─────────────────────────────────── -->
    <!-- display_decoder: char_out → 7-segment pattern         -->
    <comp lib="6" loc="(960,300)" name="display_decoder"/>

    <!-- Splitter: seg[6:0] → 7 individual bits for 7-Seg pins -->
    <comp lib="0" loc="(1090,300)" name="Splitter">
      <a name="incoming" val="7"/>
      <a name="outgoing" val="7"/>
      <a name="appear" val="left"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- 7-Segment Display (shows encrypted letter) -->
    <comp lib="5" loc="(1220,300)" name="7-Segment Display">
      <a name="active" val="true"/>
    </comp>

    <!-- POS display: 3× Hex Digit Display for rotor positions -->
    <comp lib="5" loc="(960,450)" name="Hex Digit Display">
      <a name="label" val="POS1(III)"/>
    </comp>
    <comp lib="5" loc="(1040,450)" name="Hex Digit Display">
      <a name="label" val="POS2(II)"/>
    </comp>
    <comp lib="5" loc="(1120,450)" name="Hex Digit Display">
      <a name="label" val="POS3(I)"/>
    </comp>

    <!-- Wires: out_reg Q → display_decoder char -->
    <wire from="(830,300)" to="(920,300)"/>
    <wire from="(920,300)" to="(940,300)"/>

    <!-- Wires: display_decoder seg[6:0] → Splitter input -->
    <wire from="(1000,300)" to="(1060,300)"/>
    <wire from="(1060,300)" to="(1070,300)"/>

    <!-- Wires: Splitter → 7-Segment Display (segments a–g) -->
    <wire from="(1110,268)" to="(1190,268)"/>
    <wire from="(1110,276)" to="(1190,276)"/>
    <wire from="(1110,284)" to="(1190,284)"/>
    <wire from="(1110,292)" to="(1190,292)"/>
    <wire from="(1110,300)" to="(1190,300)"/>
    <wire from="(1110,308)" to="(1190,308)"/>
    <wire from="(1110,316)" to="(1190,316)"/>

    <!-- Wires: stepping POS → Hex Digit Displays -->
    <!-- POS1 (Rotor III) -->
    <wire from="(300,180)" to="(300,440)"/>
    <wire from="(300,440)" to="(940,440)"/>
    <wire from="(940,440)" to="(940,450)"/>
    <!-- POS2 (Rotor II) -->
    <wire from="(310,200)" to="(310,445)"/>
    <wire from="(310,445)" to="(1020,445)"/>
    <wire from="(1020,445)" to="(1020,450)"/>
    <!-- POS3 (Rotor I) -->
    <wire from="(320,220)" to="(320,450)"/>
    <wire from="(320,450)" to="(1100,450)"/>
    <wire from="(1100,450)" to="(1100,450)"/>
  </circuit>

  <!-- ══════════════════════════════════════════════════════════
       CIRCUIT: display_decoder
       ────────────────────────────────────────────────────────
       Input : char[4:0]   (0=A … 25=Z)
       Output: seg[6:0]    (segments a–g, bit6=a … bit0=g)

       7-Segment layout:
            aaa
           f   b      bit[6]=a(top)    bit[5]=b(top-right)
           f   b      bit[4]=c(bot-right) bit[3]=d(bottom)
            ggg       bit[2]=e(bot-left) bit[1]=f(top-left)
           e   c      bit[0]=g(middle)
           e   c
            ddd

       ROM hex (addr=letter index 0–25, data=7-bit segment code):
         A=77  b=1F  C=4E  d=3D  E=4F  F=47
         G=5F  H=37  I=06  J=3C  K=37  L=0E
         M=76  n=15  O=3F  P=67  q=73  r=05
         S=5B  t=0F  U=3E  v=1C  W=14  X=37
         Y=33  Z=6D
       ══════════════════════════════════════════════════════════ -->
  <circuit name="display_decoder">
    <a name="circuit" val="display_decoder"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>

    <!-- Input: 5-bit letter index (0=A..25=Z) -->
    <comp lib="0" loc="(40,150)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="5"/>
      <a name="label" val="char"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- ROM 32×7: lookup 7-segment pattern for each letter A–Z -->
    <comp lib="4" loc="(200,150)" name="ROM">
      <a name="addrWidth" val="5"/>
      <a name="dataWidth" val="7"/>
      <a name="contents">addr/data
0 77 1f 4e 3d 4f 47 5f 37 06 3c 37 0e 76 15 3f 67
10 73 05 5b 0f 3e 1c 14 37 33 6d
</a>
    </comp>

    <!-- Output: 7-bit segment bus (bit6=a … bit0=g) -->
    <comp lib="0" loc="(380,150)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="7"/>
      <a name="label" val="seg"/>
      <a name="facing" val="east"/>
    </comp>

    <wire from="(40,150)" to="(160,150)"/>
    <wire from="(240,150)" to="(380,150)"/>
  </circuit>

</project>
